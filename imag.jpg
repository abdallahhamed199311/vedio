xt/css" href="imag_files/c7b3a26e7c0a.css"><link rel="stylesheet" type="text/css" href="imag_files/0c5e0a2f7584.css"><link rel="stylesheet" type="text/css" href="imag_files/c1ab3ca954c9.css"><link rel="stylesheet" type="text/css" href="imag_files/3f8baba9d713.css"><link rel="stylesheet" type="text/css" href="imag_files/cf86acabebd1.css"><link rel="stylesheet" type="text/css" href="imag_files/f813678c40c7.css"><meta http-equiv="origin-trial" content="AlnX2n8fbR+95JAKNy3dCRDeQYJ46G0yr7KdRPQoWh1FvKzmOhwQIFNCWfjj/dQmBLr5nK67TpzCTHvjptvlagkAAABmeyJvcmlnaW4iOiJodHRwczovL2NoYXRncHQuY29tOjQ0MyIsImZlYXR1cmUiOiJXZWJSdGNTY3RwU25hcCIsImV4cGlyeSI6MTgwNjM2NDgwMCwiaXNTdWJkb21haW4iOnRydWV9"><link rel="stylesheet" type="text/css" href="imag_files/6b41eac6f5f7.css"><link rel="stylesheet" type="text/css" href="imag_files/32a486438198.css"><link rel="stylesheet" type="text/css" href="imag_files/c825ae976f4c.css"><link rel="stylesheet" type="text/css" href="imag_files/46d45c1982a9.css"><link rel="stylesheet" type="text/css" href="imag_files/c56e66b9a94c.css"><link rel="stylesheet" type="text/css" href="imag_files/a73d84d071a3.css"><link rel="stylesheet" type="text/css" href="imag_files/1a495d5060c1.css"><link rel="stylesheet" type="text/css" href="imag_files/b23bc2eae490.css"><link rel="stylesheet" type="text/css" href="imag_files/085fdeaa17da.css"><style type="text/css">
  .with-scroll-bars-hidden {
   overflow: hidden !important;
   padding-right: 0px !important;
  }
  body[data-scroll-locked] {
    overflow: hidden !important;
    overscroll-behavior: contain;
    position: relative !important;
    padding-left: 0px;
    padding-top: 0px;
    padding-right: 0px;
    margin-left:0;
    margin-top:0;
    margin-right: 0px !important;
    
  }
  
  .right-scroll-bar-position {
    right: 0px !important;
  }
  
  .width-before-scroll-bar {
    margin-right: 0px !important;
  }
  
  .right-scroll-bar-position .right-scroll-bar-position {
    right: 0 !important;
  }
  
  .width-before-scroll-bar .width-before-scroll-bar {
    margin-right: 0 !important;
  }
  
  body[data-scroll-locked] {
    --removed-body-scroll-bar-size: 0px;
  }
</style></head><body data-contain-pane-overscroll="" style="--text-page-body: 15px; --page-font-scale: 1.0714285714285714; --font-ui-size: 16px; --text-4xl: 36px; --text-3xl: 30px; --text-2xl: 24px; --text-xl: 20px; --text-lg: 18px; --text-base: 16px; --text-sm: 14px; --text-xs: 12px; --text-dynamic-isle-row: 14px; --text-heading-lg: 24px; --text-heading-app: 28px; --text-heading-md: 20px; --text-heading-sm: 18px; pointer-events: none;" data-scroll-locked="1"><span data-radix-focus-start="" style="display:contents" data-aria-hidden="true" aria-hidden="true"><span data-radix-focus-guard="" tabindex="0" style="outline: none; opacity: 0; position: fixed; pointer-events: none;"></span></span><script nonce="">
(() => {
  const key = "oai-epic-native-launch";
  let launch = null;
  try { launch = JSON.parse(sessionStorage.getItem(key) || "null"); } catch {}
  function save() {
    try {
      if (launch) sessionStorage.setItem(key, JSON.stringify(launch));
      else sessionStorage.removeItem(key);
    } catch { launch = null; }
  }
  function capture() {
    const fragment = window.location.hash;
    if (!fragment) return;
    window.history.replaceState(window.history.state, "", "/epic/launch");
    const params = new URLSearchParams(fragment.slice(1));
    const snapshot = params.get("snapshot");
    const workspace = params.get("workspace_id");
    launch = Array.from(params).length === (workspace ? 2 : 1) && (!workspace || /^[A-Za-z0-9_-]{1,128}$/.test(workspace)) && snapshot &&
      /^[A-Za-z0-9_-]{80,16384}={0,2}$/.test(snapshot)
      ? { snapshot, workspace, id: crypto.randomUUID(), messageId: null, draftId: null } : null;
    save();
  }
  if (window.location.pathname === "/epic/launch") capture();
  function pending() {
    return launch && !launch.draftId && new URLSearchParams(window.location.search).get("epic_launch") === launch.id
      ? launch.snapshot : null;
  }
  window.__oaiEpicNativeLaunch = {
    get: () => launch?.snapshot ?? null,
    workspace: () => launch?.workspace ?? null,
    destination: () => launch ? "/?surface=work&epic_launch=" + launch.id : "/epic/launch",
    pending,
    ownsMessage: (messageId) => launch?.messageId === messageId,
    metadata: (messageId, draftId) => {
      if (!launch) return;
      if (draftId != null) {
        if (launch.draftId ? launch.draftId !== draftId : !pending()) return;
        launch.draftId = draftId;
      } else if (launch.messageId !== messageId) return;
      const changed = launch.messageId !== messageId;
      launch.messageId = messageId;
      save();
      if (changed) window.dispatchEvent(new Event("oai-epic-launch-changed"));
      return launch ? { epic_launch_snapshot: launch.snapshot } : undefined;
    },
    claimAttachmentNotification: (expected) => {
      if (!launch || launch.snapshot !== expected || launch.attachmentNotified) return false;
      launch.attachmentNotified = true;
      save();
      return true;
    },
    clear: (expected) => {
      if (launch?.snapshot === expected || launch?.messageId === expected) {
        launch = null;
        save();
        window.dispatchEvent(new Event("oai-epic-launch-changed"));
      }
    }
  };
  window.addEventListener("hashchange", () => {
    if (window.location.pathname !== "/epic/launch" || !window.location.hash) return;
    capture();
    window.dispatchEvent(new Event("oai-epic-launch-changed"));
  });
})();
